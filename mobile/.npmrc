# Expo SDK 57 ships react@19.2.3 while @expo/devtools pulls react-dom@19.3.0,
# which peer-requires react@^19.3.0. npm's strict peer resolution refuses that
# tree. Pinning the mode here keeps every install in this project consistent —
# mixing `expo install` with a plain `npm install` otherwise prunes transitive
# dependencies and leaves the bundler unable to resolve expo-asset.
legacy-peer-deps=true
