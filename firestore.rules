rules_version = '2';

// ============================================================
// Muhai — Firestore security rules
//
// Model: one company per account. A user document links a Firebase
// uid to exactly one company; the company document carries a
// `members` list. Everything the company owns lives in
// subcollections beneath it, so one ownership check covers them all.
//
// Deploy:  firebase deploy --only firestore:rules
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Membership is read from the company document, so a user cannot
    // grant themselves access by editing their own user doc.
    function isMember(companyId) {
      return signedIn()
        && exists(/databases/$(database)/documents/companies/$(companyId))
        && request.auth.uid in get(/databases/$(database)/documents/companies/$(companyId)).data.members;
    }

    // ── users/{uid} — the uid → companyId link ────────────────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      // Created once at registration and only ever by its owner.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.companyId is string;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ── companies/{companyId} ─────────────────────────────────
    match /companies/{companyId} {
      allow read: if isMember(companyId);

      // At creation the author must put themselves in members and claim
      // ownership — otherwise a user could create a company owned by
      // someone else, or one they cannot subsequently read.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      // Ownership and the member list are immutable through this path;
      // changing them is an admin operation, not a client one.
      allow update: if isMember(companyId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.members == resource.data.members;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // ── Everything the company owns ─────────────────────────
      // invoices, transactions, products, employees, taxObligations
      match /{collection}/{docId} {
        allow read, write: if isMember(companyId);
      }
    }

    // Anything not matched above is denied.
  }
}
