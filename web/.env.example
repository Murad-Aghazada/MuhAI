# Frontend environment. Copy to .env.local (git-ignored) and fill in.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# anything set here is PUBLIC once built. Do not put real secrets in it.
#
# The Firebase web config below is *designed* to be public: it identifies the
# project, it does not grant access. Access is controlled by Firebase Auth plus
# the Firestore security rules in firestore.rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Muhai compute API (FastAPI). Everything that is *calculated* — the 2026 tax
# engine, Muhai Score, Prophet forecasting, payroll, OCR and the assistant —
# runs there. Firestore holds the data; this holds the maths.
VITE_API_URL=http://localhost:8000
