# ─── Backend environment ───────────────────────────────────────────────
# Copy to .env and adjust. In Docker these are supplied by the root .env via
# docker-compose.yml; this file documents the same variables for running the
# API directly on a workstation.

# Async SQLAlchemy connection string (asyncpg driver).
# Inside Docker the host is the service name: ...@postgres:5432/muhai
DATABASE_URL=postgresql+asyncpg://muhai:muhai_secret@localhost:5432/muhai

# Redis (Celery broker + result backend). In Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — generate with: openssl rand -hex 32
# Sessions are signed with this. Changing it signs everyone out.
SECRET_KEY=change_me_in_production

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Tesseract OCR language (Turkish + English)
OCR_LANG=tur+eng

# CORS — comma separated origins allowed to call the API.
# On the VPS this is your site's real origin, e.g. https://muhai.example.com
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ─── Compute layer ─────────────────────────────────────────────────────
# /api/compute reads no table but still requires a signed-in caller.
# Set false ONLY for an offline demo on a machine nobody else can reach.
COMPUTE_AUTH_REQUIRED=true

# Gemini key for the server-side assistant. Empty -> the offline BM25 knowledge
# base answers instead. Never put this in the frontend bundle.
GEMINI_API_KEY=
GEMINI_MODEL=
