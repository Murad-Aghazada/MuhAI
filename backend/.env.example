# ─── Backend environment ───────────────────────────────────────────────
# Copy to .env and adjust for your environment.

# Async SQLAlchemy connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://muhai:muhai_secret@localhost:5432/muhai

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — generate with: openssl rand -hex 32
SECRET_KEY=change_me_in_production

# JWT settings
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# Tesseract OCR language (Turkish + English)
OCR_LANG=tur+eng

# CORS — comma separated origins allowed to call the API
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://localhost:19006,exp://127.0.0.1:19000

# ─── Firebase ──────────────────────────────────────────────────────────
# Firestore is the system of record; this API is a stateless compute layer.
# Callers send a Firebase ID token, verified against this project id using
# Google's public certificates — no service-account key needed.
FIREBASE_PROJECT_ID=

# Set false ONLY for an offline demo where Google's certificate endpoint is
# unreachable; /api/compute then accepts unauthenticated calls.
FIREBASE_AUTH_REQUIRED=true

# Gemini key for the server-side assistant. Empty -> deterministic offline
# fallback. Never put this in the frontend bundle.
GEMINI_API_KEY=
