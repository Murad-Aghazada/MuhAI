# ============================================================
# Muhai — Docker Compose environment.
#
#     cp .env.example .env
#     openssl rand -hex 32        # paste into SECRET_KEY
#
# Compose reads this file automatically. It is the single place the whole
# stack is configured; the containers get no other configuration.
#
# .env is git-ignored. Never commit a filled-in copy.
# ============================================================

# ── Required ───────────────────────────────────────────────────────────
# Sessions are signed with this. Compose refuses to start without it.
# Changing it on a running deployment signs every user out.
SECRET_KEY=

# ── Database ───────────────────────────────────────────────────────────
# Used both to initialise Postgres and to build the API's DATABASE_URL.
# Change the password before the first `up`: after the volume is created,
# changing it here no longer changes the password inside the database.
POSTGRES_USER=muhai
POSTGRES_PASSWORD=muhai_secret
POSTGRES_DB=muhai

# ── Web ────────────────────────────────────────────────────────────────
# The only published port. Put a TLS terminator in front of it on the VPS
# (see docs/DEPLOY.md) and set this to 8080 so nginx or Caddy can own :80.
WEB_PORT=80

# Leave empty. The browser then calls /api on its own origin and the web
# container's nginx proxies it to the backend — no CORS, no API hostname
# baked into the bundle. Set it only if the API runs on a different host.
VITE_API_URL=

# ── API ────────────────────────────────────────────────────────────────
# uvicorn workers. Roughly one per CPU core; 2 suits a small VPS.
API_WORKERS=2

# Only needed when the browser is served from an origin the API does not
# share — i.e. the Vite dev server, or a split deployment. With the nginx
# proxy above, production needs nothing here.
#
# 5174/5175 are Vite's fallbacks when 5173 is already held by a dev server
# someone forgot to stop. `strictPort` in vite.config.js now refuses to move
# instead, but these stay listed so a second checkout or a preview build
# (4173) does not present as an unexplained CORS block.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175,http://127.0.0.1:5175,http://localhost:4173,http://127.0.0.1:4173

# Session lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# /api/compute reads no table but still requires a signed-in caller.
# Set false ONLY for an offline demo on a machine nobody else can reach.
COMPUTE_AUTH_REQUIRED=true

# ── AI ─────────────────────────────────────────────────────────────────
# Server-side assistant and agent. Empty is a supported configuration: both
# fall back to the local BM25 knowledge base and say so in the UI.
#
# AI_PROVIDER picks the vendor: openai | gemini | offline. Leave it empty to
# auto-select — OpenAI if its key is set, else Gemini, else offline. Switching
# vendors is this line plus a key; no code and no rebuild.
AI_PROVIDER=

OPENAI_API_KEY=
# Empty -> gpt-4o-mini.
OPENAI_MODEL=
# Any OpenAI-compatible gateway: Azure OpenAI, OpenRouter, LiteLLM, a local
# Ollama (http://host.docker.internal:11434/v1). Empty -> api.openai.com.
OPENAI_BASE_URL=
# Reasoning models only: none | low | medium | high. Empty lets the model
# decide. You do not need this for tool calls — a reasoning model refuses
# function tools unless the effort is "none", and llm.py already retries that
# way on its own.
OPENAI_REASONING_EFFORT=

GEMINI_API_KEY=
# Empty -> gemini-2.5-flash.
GEMINI_MODEL=

# ── Bank integration ───────────────────────────────────────────────────
# Optional. Leave BANK_PROVIDER empty and the Bank screen offers CSV
# statement import only — which needs no bank, no internet and no contract.
# Set it to "mock" to demonstrate the whole flow with generated movements.
#
# With real API access: pick the preset, then paste the base URL, token URL
# and credentials from the bank's developer portal. No code changes.
#   custom | mock | garanti | isbank | akbank | yapikredi | qnb |
#   denizbank | kuveytturk | vakifbank | ziraat
BANK_PROVIDER=

# Overrides the preset's auth style when the contract differs:
#   oauth2_client_credentials | static_bearer | api_key_header
BANK_AUTH_STYLE=

# Issued with the credentials rather than published, so they live here.
BANK_API_BASE_URL=
BANK_TOKEN_URL=
BANK_SCOPE=
BANK_CLIENT_ID=
BANK_CLIENT_SECRET=
BANK_API_KEY=
BANK_API_KEY_HEADER=
BANK_ACCESS_TOKEN=
BANK_CONSENT_ID=

# Endpoint shape. Defaults are /accounts and
# /accounts/{account_id}/transactions; {account_id} is substituted, and a bank
# that takes the account as a query parameter simply leaves it out.
BANK_ACCOUNTS_PATH=
BANK_TRANSACTIONS_PATH=
BANK_SINCE_PARAM=
BANK_UNTIL_PARAM=
BANK_DATE_FORMAT=

# JSON objects. Headers the gateway requires, and per-field key overrides for
# a response shape the built-in Turkish/ISO-20022/English candidates miss:
#   BANK_EXTRA_HEADERS={"X-Channel-Code":"API"}
#   BANK_FIELD_MAP={"amount":["islemTutariTL"],"description":["detay"]}
BANK_EXTRA_HEADERS=
BANK_FIELD_MAP=

# Mutual TLS, which most regulated gateways require. Paths inside the
# container — mount the PEMs read-only.
BANK_CLIENT_CERT=
BANK_CLIENT_KEY=
BANK_CA_BUNDLE=
# Only ever false against a bank sandbox with a self-signed chain.
BANK_VERIFY_TLS=true
BANK_TIMEOUT_SECONDS=20

# Tesseract languages for server-side OCR.
# Turkish alone reads Turkish invoices better than "tur+eng" and is faster.
OCR_LANG=tur
# Folder of language models. Leave empty: the image carries tessdata_best's
# Turkish model in backend/tessdata, which reads Turkish letters better than
# the "fast" model the tesseract-ocr-tur package installs.
OCR_TESSDATA_DIR=
