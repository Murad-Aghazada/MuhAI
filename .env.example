# Frontend environment. Copy to .env.local (git-ignored) and fill in.
# Vite only exposes variables prefixed with VITE_ to the browser bundle —
# anything set here is PUBLIC once built. Do not put real secrets in it.

# Temporary: the assistant calls Gemini directly from the browser. Phase 1
# moves this behind the backend's /api/chat endpoint and this var goes away.
VITE_GEMINI_API_KEY=
